<Schema name="Twintig IMU">
    <Commands>
        <Command key="ping"/>
        <Command key="default"/>
        <Command key="apply"/>
        <Command key="save"/>
        <Command key="restart"/>
        <Command key="heading"/>
        <Command key="note"/>
        <Command key="blink"/>
        <Command key="strobe"/>
        <Command key="colour"/>
    </Commands>
    <Settings>
        <Group name="Device Information">
            <Setting key="model" name="Model" type="string" readOnly="true"/>
            <Setting key="serial_number" name="Serial Number" type="string" readOnly="true"/>
            <Setting key="hardware_version" name="Hardware Version" type="string" readOnly="true"/>
            <Setting key="bootloader_version" name="Bootloader Version" type="string" readOnly="true"/>
            <Setting key="firmware_version" name="Firmware Version" type="string" readOnly="true"/>
            <Setting key="device_name" name="Device Name" type="string"/>
        </Group>
        <Group name="IMU">
            <Setting key="sample_rate" name="Sample Rate" type="enum">
                <Enum name="12 Hz" value="12"/>
                <Enum name="25 Hz" value="25"/>
                <Enum name="50 Hz" value="50"/>
                <Enum name="100 Hz" value="100"/>
                <Enum name="200 Hz" value="200"/>
                <Enum name="400 Hz" value="400"/>
                <Enum name="800 Hz" value="800"/>
                <Enum name="1600 Hz" value="1600"/>
                <Enum name="3200 Hz" value="3200"/>
                <Enum name="6400 Hz" value="6400"/>
            </Setting>
            <Group name="Low-Pass Filters">
                <Setting key="gyroscope_low_pass_filter" name="Gyroscope" type="enum">
                    <Enum name="Bypass" value="0"/>
                    <Enum name="Sample Rate / 4" value="4"/>
                    <Enum name="Sample Rate / 8" value="8"/>
                    <Enum name="Sample Rate / 16" value="16"/>
                    <Enum name="Sample Rate / 32" value="32"/>
                    <Enum name="Sample Rate / 64" value="64"/>
                    <Enum name="Sample Rate / 128" value="128"/>
                </Setting>
                <Setting key="accelerometer_low_pass_filter" name="Accelerometer" type="enum">
                    <Enum name="Bypass" value="0"/>
                    <Enum name="Sample Rate / 4" value="4"/>
                    <Enum name="Sample Rate / 8" value="8"/>
                    <Enum name="Sample Rate / 16" value="16"/>
                    <Enum name="Sample Rate / 32" value="32"/>
                    <Enum name="Sample Rate / 64" value="64"/>
                    <Enum name="Sample Rate / 128" value="128"/>
                </Setting>
            </Group>
            <Setting key="axis_remap" name="Axis Remap" type="enum">
                <Enum name="Disabled" value="0"/>
                <Enum name="+X+Z-Y" value="1"/>
                <Enum name="+X-Z+Y" value="2"/>
                <Enum name="+X-Y-Z" value="3"/>
                <Enum name="+Y+X-Z" value="4"/>
                <Enum name="+Y+Z+X" value="5"/>
                <Enum name="+Y-Z-X" value="6"/>
                <Enum name="+Y-X+Z" value="7"/>
                <Enum name="+Z+X+Y" value="8"/>
                <Enum name="+Z+Y-X" value="9"/>
                <Enum name="+Z-Y+X" value="10"/>
                <Enum name="+Z-X-Y" value="11"/>
                <Enum name="-Z+X-Y" value="12"/>
                <Enum name="-Z+Y+X" value="13"/>
                <Enum name="-Z-Y-X" value="14"/>
                <Enum name="-Z-X+Y" value="15"/>
                <Enum name="-Y+X+Z" value="16"/>
                <Enum name="-Y+Z-X" value="17"/>
                <Enum name="-Y-Z+X" value="18"/>
                <Enum name="-Y-X-Z" value="19"/>
                <Enum name="-X+Y-Z" value="20"/>
                <Enum name="-X+Z+Y" value="21"/>
                <Enum name="-X-Z-Y" value="22"/>
                <Enum name="-X-Y+Z" value="23"/>
            </Setting>
            <Setting key="bias_correction" name="Bias Correction" type="bool"/>
            <Group name="AHRS">
                <Setting key="ahrs_update_rate_divisor" name="Update Rate Divisor" type="number"/>
                <Setting key="axes_convention" name="Axes Convention" type="enum">
                    <Enum name="North, West, Up (NWU)" value="0"/>
                    <Enum name="East, North, Up (ENU)" value="1"/>
                    <Enum name="North, East, Down (NED)" value="2"/>
                </Setting>
                <Setting key="ahrs_gain" name="Gain" type="number"/>
                <Setting key="overrange_recovery" name="Overrange Recovery" type="bool"/>
                <Setting key="acceleration_rejection" name="Acceleration Rejection" type="bool"/>
            </Group>
        </Group>
        <Group name="Data Messages">
            <Setting key="data_message_mode" name="Mode" type="enum">
                <Enum name="Binary" value="0"/>
                <Enum name="ASCII" value="1"/>
            </Setting>
            <Group name="Message Modes">
                <Setting key="orientation_mode" name="Orientation" type="enum">
                    <Enum name="Quaternion" value="0"/>
                    <Enum name="Rotation Matrix" value="1"/>
                    <Enum name="Euler Angles" value="2"/>
                </Setting>
            </Group>
            <Group name="Message Rate Divisors">
                <Setting key="inertial_message_rate_divisor" name="Inertial" type="number"/>
                <Setting key="orientation_message_rate_divisor" name="Orientation" type="number"/>
                <Setting key="temperature_message_rate_divisor" name="Temperature" type="number"/>
            </Group>
            <Group name="Interfaces">
                <Setting key="usb_send_mode" name="USB" type="enum">
                    <Enum name="Disabled" value="0"/>
                    <Enum name="Blocking" value="1"/>
                    <Enum name="Non-Blocking" value="2"/>
                </Setting>
                <Setting key="serial_send_mode" name="Serial" type="enum">
                    <Enum name="Disabled" value="0"/>
                    <Enum name="Blocking" value="1"/>
                    <Enum name="Non-Blocking" value="2"/>
                </Setting>
            </Group>
        </Group>
    </Settings>
</Schema>